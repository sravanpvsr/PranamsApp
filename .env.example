# Copy to .env (same folder as manage.py) and fill in. .env is gitignored.
#
# Generate a fresh secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Never reuse the old key that was committed to settings.py - it is public.
DJANGO_SECRET_KEY=replace-with-generated-key

# False in production. Set to True only on your laptop.
DJANGO_DEBUG=False

# Comma-separated, no spaces needed.
DJANGO_ALLOWED_HOSTS=pranams2.pythonanywhere.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=pranams2.pythonanywhere.com

# Secure-only cookies. Defaults to on when DEBUG is off; set False only if the
# site must be reached over plain http.
# DJANGO_SECURE_COOKIES=True
